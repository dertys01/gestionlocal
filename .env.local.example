# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# Clé service role : serveur uniquement, contourne la RLS.
# Ne jamais l'exposer au navigateur (NEXT_PUBLIC_ la rendrait publique).
#
# OPTIONNELLE en local : l'application démarre et fonctionne sans elle. Elle ne
# sert qu'à /api/register (créer un compte), /api/invitations/accept et
# /api/stripe/* — qui répondent 503 sans elle. Voir SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Temps réel multi-caisses (optionnel) ────────────────────
# "1" active l'abonnement Supabase Realtime : le catalogue et les chiffres du
# jour d'un appareil se rafraîchissent quand une AUTRE caisse du même commerce
# encaisse ou réapprovisionne. Inerte (aucune connexion WebSocket) si absent.
# Nécessite d'avoir appliqué supabase/migration_realtime.sql (publication
# supabase_realtime). Une connexion par onglet ouvert, facturée par Supabase.
NEXT_PUBLIC_REALTIME=

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ── Sentry ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Jeton personnel Supabase (migrations par scripts/supabase-sql.mjs)
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── Formules freemium ───────────────────────────────────────
# Prix et quotas des plans. Le dépôt est public : le mécanisme est dans
# src/lib/utils/plans.ts, les VALEURS ne vivent que dans cet fichier (local)
# et dans le tableau de bord du déploiement (production). "null" = illimité.
# Variable absente ou invalide = illimité partout et prix affichés « — » :
# l'application fonctionne, elle ne vend rien de chiffré.
# Après un changement : relancer le build, puis
# node scripts/sync-plan-config.mjs pour resynchroniser plan_config en base.
#
# Forme (les null ci-dessous ne sont PAS une offre, juste la grammaire) :
# {"quotas":{"free":{"products":null,"employees":null,"historyDays":null},
#            "starter":{"products":null,"employees":null,"historyDays":null},
#            "pro":{"products":null,"employees":null,"historyDays":null}},
#  "prices":{"starter":{"monthly":null,"yearly":null},
#            "pro":{"monthly":null,"yearly":null}}}
NEXT_PUBLIC_PLANS_CONFIG=

# ── Mobile Money (Sprint 19 — squelette) ─────────────────────
# 'sandbox' : parcours complet, aucun appel réseau, aucun débit réel.
#   PAYMENTS_SANDBOX=1 ouvre la page de confirmation locale ;
#   sans cette valeur, toute commande répond « indisponible » (défaut
#   fermé — un déploiement oublié ne vend jamais du faux).
# 'fedapay' / 'paydunya' : squelettes — refusent tant que les clés et les
#   appels API ne sont pas écrits après l'essai en bac à sable.
PAYMENTS_PROVIDER=sandbox
PAYMENTS_SANDBOX=
# FEDAPAY_API_KEY=
# PAYDUNYA_API_KEY=

# ── Facture normalisée e-MECeF (DGI Bénin) ───────────────────
# Jeton de connexion au service de facturation, délivré par la DGI après
# accord. Comme la clé service role : serveur uniquement, jamais dans le
# dépôt, jamais dans le navigateur. Sans jeton, la caisse n'offre la
# délivrance d'aucune facture : le reçu simple reste le seul papier imprimé.
# Les appels sont écrits (src/lib/mecef/client.ts) : poser le jeton ouvre la
# délivrance — soumission, confirmation, code MECeF/QR/NIM.
# Voir SECURITY.md.
# MECEF_TOKEN=
# URL de l'API e-MECeF. Vide = environnement développeur/test de la DGI
# (https://developper.impots.bj/sygmef-emcf/api). À renseigner avec l'URL de
# PRODUCTION le jour où la DGI la communique.
# MECEF_BASE_URL=

# ── Bêta : boîte de réception des retours (éditeur) ──────────
# Adresses (séparées par des virgules) autorisées à lire les retours de TOUTES
# les boutiques via /api/admin/feedback et la page /admin/retours. Vide = la
# page répond « accès réservé à l'éditeur ». Serveur uniquement.
# ADMIN_EMAILS=vous@exemple.com
